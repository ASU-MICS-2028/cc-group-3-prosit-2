<mxfile><diagram name="HealthConnect architecture" id="hc"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2900" pageHeight="1490"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="CLIENT LAYER: devices on the internet" style="rounded=1;arcSize=2;fillColor=#f1f5fb;strokeColor=#7a8fb5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;fontColor=#7a8fb5" vertex="1" parent="1"><mxGeometry x="40" y="90" width="2820" height="170" as="geometry"/></mxCell><mxCell id="3" value="VPC 10.30.0.0/16 (af-south-1, two Availability Zones)" style="rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#b03030;strokeWidth=2;verticalAlign=top;align=right;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;fontColor=#b03030" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1700" height="900" as="geometry"/></mxCell><mxCell id="4" value="PUBLIC SUBNETS" style="rounded=1;arcSize=2;fillColor=#e8f2e8;strokeColor=#8fb08f;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;fontColor=#8fb08f" vertex="1" parent="1"><mxGeometry x="70" y="345" width="1640" height="215" as="geometry"/></mxCell><mxCell id="5" value="PRIVATE APP SUBNETS: API layer" style="rounded=1;arcSize=2;fillColor=#e7eef8;strokeColor=#8fa5c8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;fontColor=#8fa5c8" vertex="1" parent="1"><mxGeometry x="70" y="585" width="1640" height="330" as="geometry"/></mxCell><mxCell id="6" value="PRIVATE DATA SUBNETS: data layer, no route to the internet" style="rounded=1;arcSize=2;fillColor=#f8ebe8;strokeColor=#c89a90;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;fontColor=#c89a90" vertex="1" parent="1"><mxGeometry x="70" y="940" width="1640" height="235" as="geometry"/></mxCell><mxCell id="7" value="EVENT / SERVERLESS LAYER (outside the VPC, managed by AWS)" style="rounded=1;arcSize=2;fillColor=#fff8ea;strokeColor=#d9a441;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;fontColor=#d9a441" vertex="1" parent="1"><mxGeometry x="1780" y="300" width="1080" height="640" as="geometry"/></mxCell><mxCell id="8" value="OTHER AWS SERVICES" style="rounded=1;arcSize=2;fillColor=#f4f4f4;strokeColor=#999999;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;fontColor=#999999" vertex="1" parent="1"><mxGeometry x="1780" y="980" width="1080" height="220" as="geometry"/></mxCell><mxCell id="9" value="SECURITY LAYER: applies to everything above" style="rounded=1;arcSize=2;fillColor=#f4eefa;strokeColor=#8a6bb5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;fontColor=#8a6bb5" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="2820" height="195" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;Health worker&#x27;s phone&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;CHV offline app (PWA): planned, frontend/ not built yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="120" y="130" width="400" height="105" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;Browser or phone: person A&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;opens the call page; camera + microphone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="620" y="130" width="400" height="105" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;Browser or phone: person B&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;same call page; shows live call stats&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1120" y="130" width="400" height="105" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;Public STUN server&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;free; tells each browser its public address&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1640" y="130" width="380" height="105" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;TURN relay: not built&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;fallback if a direct call is blocked (cost: L7-H3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="2100" y="130" width="400" height="105" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;Application Load Balancer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;HTTPS :443 (TLS 1.3 preferred, 1.2 allowed), HTTP :80 redirects to HTTPS; api-hc.* goes to the API, call-hc.* to the call server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="640" y="400" width="700" height="130" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;NAT instance (fck-nat)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;outbound only: image pulls from ECR, updates; one server, AZ a&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1380" y="400" width="300" height="130" as="geometry"/></mxCell><mxCell id="17" value="&lt;b&gt;Call server (1 instance)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;webrtc-spike: signaling over WSS (:3000). Video never passes through it. Rooms kept in its memory, so exactly one (D-023)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="100" y="660" width="380" height="200" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;API server, AZ a&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;patient-record-service (:8000): sign-in, patients, appointments, audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="580" y="680" width="340" height="170" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;API server, AZ b&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;same container image; the load balancer spreads requests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="980" y="680" width="340" height="170" as="geometry"/></mxCell><mxCell id="20" value="&lt;b&gt;RDS PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;FHIR-shaped tables, access_log (append-only), appointments. Not publicly accessible, encrypted at rest; port 5432 only from the API servers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="520" y="985" width="640" height="150" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;SNS topic: appointment-events&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;the API publishes one event when an appointment is saved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1950" y="380" width="760" height="105" as="geometry"/></mxCell><mxCell id="22" value="&lt;b&gt;SQS: reminders&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;keeps messages safe; 3 failed tries, then the DLQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1810" y="560" width="330" height="100" as="geometry"/></mxCell><mxCell id="23" value="&lt;b&gt;DLQ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;dead-letter queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="2160" y="560" width="170" height="100" as="geometry"/></mxCell><mxCell id="24" value="&lt;b&gt;SQS: specialist-notify&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;its own copy of the event; 3 failed tries, then its DLQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="2370" y="560" width="330" height="100" as="geometry"/></mxCell><mxCell id="25" value="&lt;b&gt;DLQ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;dead-letter queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=13" vertex="1" parent="1"><mxGeometry x="2720" y="560" width="120" height="100" as="geometry"/></mxCell><mxCell id="26" value="&lt;b&gt;Lambda: reminder&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;logs the reminder (real SMS not connected)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1810" y="740" width="330" height="120" as="geometry"/></mxCell><mxCell id="27" value="&lt;b&gt;Lambda: specialist-notify&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;logs the specialist notification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="2370" y="740" width="330" height="120" as="geometry"/></mxCell><mxCell id="28" value="&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;container images (API, call)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1810" y="1030" width="230" height="110" as="geometry"/></mxCell><mxCell id="29" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;patient photos, private&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="2065" y="1030" width="230" height="110" as="geometry"/></mxCell><mxCell id="30" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;logs, alarms, dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="2320" y="1030" width="250" height="110" as="geometry"/></mxCell><mxCell id="31" value="&lt;b&gt;SSM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;Session Manager: server access, no SSH keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f4f4;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="2595" y="1030" width="235" height="110" as="geometry"/></mxCell><mxCell id="32" value="&lt;b&gt;TLS + ACM certificate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;TLS 1.3 preferred (1.2 allowed): all traffic encrypted in transit; plain HTTP is redirected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe8f7;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="70" y="1300" width="500" height="120" as="geometry"/></mxCell><mxCell id="33" value="&lt;b&gt;IAM role per component&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;API, call server, NAT and each Lambda: only what it needs; no keys in code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe8f7;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="600" y="1300" width="520" height="120" as="geometry"/></mxCell><mxCell id="34" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;database password and sign-in token key; read only by the API role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe8f7;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1150" y="1300" width="520" height="120" as="geometry"/></mxCell><mxCell id="35" value="&lt;b&gt;Security groups&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;database port open only to the API servers; API only to the load balancer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe8f7;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="1700" y="1300" width="500" height="120" as="geometry"/></mxCell><mxCell id="36" value="&lt;b&gt;Sign-in + audit log&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;who is acting comes from a verified token; every read and write is logged, append-only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe8f7;strokeColor=#2b2b2b;strokeWidth=2;dashed=0;fontSize=13" vertex="1" parent="1"><mxGeometry x="2230" y="1300" width="600" height="120" as="geometry"/></mxCell><mxCell id="37" value="HTTPS (api-hc)" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="235" as="sourcePoint"/><mxPoint x="700" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="HTTPS + WSS (call-hc)" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="235" as="sourcePoint"/><mxPoint x="900" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="39" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="235" as="sourcePoint"/><mxPoint x="1240" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="40" value="video + audio go directly (WebRTC)" style="endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=2;dashed=1;strokeColor=#666666;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="182" as="sourcePoint"/><mxPoint x="1120" y="182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="41" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=1;strokeColor=#666666;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="182" as="sourcePoint"/><mxPoint x="1640" y="182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="42" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=1;strokeColor=#666666;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="160" as="sourcePoint"/><mxPoint x="1520" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="43" value=":3000" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="530" as="sourcePoint"/><mxPoint x="330" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="44" value=":8000" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="530" as="sourcePoint"/><mxPoint x="750" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="45" value=":8000" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="530" as="sourcePoint"/><mxPoint x="1150" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="46" value=":5432" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="850" as="sourcePoint"/><mxPoint x="740" y="985" as="targetPoint"/></mxGeometry></mxCell><mxCell id="47" value=":5432" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="850" as="sourcePoint"/><mxPoint x="1010" y="985" as="targetPoint"/></mxGeometry></mxCell><mxCell id="48" value="sns:Publish" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="765" as="sourcePoint"/><mxPoint x="1950" y="432" as="targetPoint"/><Array as="points"><mxPoint x="1760" y="765"/><mxPoint x="1760" y="432"/></Array></mxGeometry></mxCell><mxCell id="49" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2070" y="485" as="sourcePoint"/><mxPoint x="1975" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="50" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2590" y="485" as="sourcePoint"/><mxPoint x="2535" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="51" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=1;strokeColor=#666666;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2140" y="610" as="sourcePoint"/><mxPoint x="2160" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="52" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=1;strokeColor=#666666;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2700" y="610" as="sourcePoint"/><mxPoint x="2720" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="53" value="triggers" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1975" y="660" as="sourcePoint"/><mxPoint x="1975" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="54" value="triggers" style="endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=2;dashed=0;strokeColor=#2b2b2b;fontSize=11" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2535" y="660" as="sourcePoint"/><mxPoint x="2535" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="55" value="Our servers never carry the call: they only help the two browsers find each other. The STUN server (dashed arrows) is how each browser learns its public address." style="text;html=1;fontStyle=2;fontColor=#666666;fontSize=12;align=left" vertex="1" parent="1"><mxGeometry x="60" y="1211" width="2700" height="28" as="geometry"/></mxCell><mxCell id="56" value="HealthConnect Ghana: architecture as built for Lab 7" style="text;html=1;fontStyle=1;fontSize=28;align=center" vertex="1" parent="1"><mxGeometry x="0" y="20" width="2900" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>