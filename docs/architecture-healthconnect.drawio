gt;S3: media&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5A6C86"&gt;patient photos&lt;br&gt;versioned, private&lt;/font&gt;' style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;" vertex="1" parent="region"><mxGeometry x="1010" y="580" width="48" height="48" as="geometry"/></mxCell><mxCell id="sec" value='&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5A6C86"&gt;DB password, JWT key&lt;/font&gt;' style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fillColor=#DD344C;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;" vertex="1" parent="region"><mxGeometry x="1140" y="580" width="48" height="48" as="geometry"/></mxCell><mxCell id="ecr" value='&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5A6C86"&gt;API + call images&lt;/font&gt;' style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;fillColor=#ED7100;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;" vertex="1" parent="region"><mxGeometry x="1270" y="580" width="48" height="48" as="geometry"/></mxCell><mxCell id="cw" value='&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5A6C86"&gt;logs, 8 alarms,&lt;br&gt;dashboard → email&lt;/font&gt;' style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;" vertex="1" parent="region"><mxGeometry x="1390" y="580" width="48" height="48" as="geometry"/></mxCell><mxCell id="ssm" value='&lt;b&gt;Systems Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5A6C86"&gt;Session Manager (no SSH)&lt;br&gt;image tag for rollouts&lt;/font&gt;' style="sketch=0;outlineConnect=0;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#E7157B;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;" vertex="1" parent="region"><mxGeometry x="1010" y="740" width="48" height="48" as="geometry"/></mxCell><mxCell id="secnote" value="&lt;b&gt;Security controls&lt;/b&gt;&lt;br&gt;• Security groups: ALB accepts 80/443 from the internet; API and call servers accept traffic only from the ALB; PostgreSQL 5432 accepts only the API servers.&lt;br&gt;• Data subnets (database only) have no route to the internet; private app subnets reach out only through the NAT instance.&lt;br&gt;• Encrypted in transit (TLS on every public endpoint) and at rest (RDS, both S3 buckets). Both buckets block all public access.&lt;br&gt;• No keys in code: servers read Secrets Manager at start-up through their IAM role; CI deploys through short-lived OIDC credentials.&lt;br&gt;• Every patient-record read and write is recorded in an append-only audit table." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#DD344C;fontSize=12;fontColor=#232F3E;fontFamily=Helvetica;" vertex="1" parent="region"><mxGeometry x="190" y="785" width="740" height="130" as="geometry"/></mxCell><mxCell id="e_cf" value="HTTPS app-hc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="phone" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_web" value="OAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;" edge="1" parent="cloud" source="cf" target="s3web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_api" value="HTTPS api-hc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;" edge="1" parent="1" source="phone" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_call" value="HTTPS + WSS call-hc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;entryX=0;entryY=0.85;" edge="1" parent="1" source="users" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_alb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;" edge="1" parent="vpc" source="igw" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_nat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;strokeColor=#879196;dashed=1;dashPattern=2 3;exitX=0;exitY=0.5;entryX=1;entryY=0.85;" edge="1" parent="vpc" source="nat" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_asg" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;exitX=0.75;exitY=1;entryX=0.5;entry