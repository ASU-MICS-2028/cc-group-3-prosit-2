{
  "name": "healthconnect-webrtc-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HealthConnect Lab 7 Part C: WebRTC signaling server + React client (proof of concept)",
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
